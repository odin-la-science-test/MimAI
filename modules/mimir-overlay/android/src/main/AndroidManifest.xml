<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Bulle assistant : permission « par-dessus les autres applis » -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- Service en avant-plan qui maintient la bulle -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- dictée depuis la bulle (activité transparente au premier plan) -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- Android 16 : la notification de Mìmir peut devenir une puce dans la barre d'état (comme un lecteur de musique) -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

  <application>
    <service
      android:name="fr.mimai.app.overlay.MimirOverlayService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="assistant_bubble_overlay" />
    </service>
    <!-- choix d'une photo depuis la bulle de discussion (transparente) -->
    <activity android:name="fr.mimai.app.overlay.MimirPickActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    <!-- dictée vocale de la bulle : transparente, se ferme toute seule, ne rouvre pas l'app -->
    <activity android:name="fr.mimai.app.overlay.MimirVoiceActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" android:noHistory="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    <!-- réponse rapide écrite dans la notification -->
    <receiver android:name="fr.mimai.app.overlay.MimirReplyReceiver" android:exported="false" />
  </application>
</manifest>
